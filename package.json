{
  "name": "cf-next-workers-d1-r2-boilerplate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lilpacy/cloudflare-next-boilerplate.git"
  },
  "homepage": "https://github.com/lilpacy/cloudflare-next-boilerplate",
  "bugs": {
    "url": "https://github.com/lilpacy/cloudflare-next-boilerplate/issues"
  },
  "scripts": {
    "dev": "nx dev web",
    "build": "nx build web",
    "start": "nx start web",
    "lint": "nx graph --file=.nx/project-graph.json && eslint .",
    "type-check": "tsc --noEmit && pnpm --filter @cf-next/ui type-check && pnpm --filter @cf-next/database type-check && pnpm --filter web type-check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "deploy": "pnpm --filter web run deploy",
    "deploy:prod": "pnpm --filter web run deploy:prod",
    "deploy:preview": "pnpm --filter web run deploy:preview",
    "preview:cf": "pnpm --filter web run preview:cf",
    "cf:typegen": "pnpm --filter web run cf:typegen",
    "db:create": "pnpm --filter web run db:create",
    "db:create:preview": "pnpm --filter web run db:create:preview",
    "db:generate": "pnpm --filter @cf-next/database generate",
    "db:migrate:local": "pnpm --filter web run db:migrate:local",
    "db:migrate:prod": "pnpm --filter web run db:migrate:prod",
    "db:migrate:preview": "pnpm --filter web run db:migrate:preview",
    "db:shell:local": "pnpm --filter web run db:shell:local",
    "db:shell:prod": "pnpm --filter web run db:shell:prod",
    "db:shell:preview": "pnpm --filter web run db:shell:preview",
    "db:export:local": "pnpm --filter web run db:export:local",
    "db:export:prod": "pnpm --filter web run db:export:prod",
    "db:export:preview": "pnpm --filter web run db:export:preview",
    "storage:create": "pnpm --filter web run storage:create",
    "storage:create:cache": "pnpm --filter web run storage:create:cache",
    "storage:create:preview": "pnpm --filter web run storage:create:preview",
    "storage:create:cache:preview": "pnpm --filter web run storage:create:cache:preview",
    "prepare": "husky",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@clerk/nextjs": "^6.39.7",
    "@clerk/testing": "^2.1.0",
    "@nx/eslint-plugin": "23.3.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20.19.18",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^4.0.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "happy-dom": "^20.3.0",
    "husky": "^9.1.7",
    "nx": "23.3.0",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.17",
    "wrangler": "^4.148.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd",
      "nx"
    ]
  }
}
